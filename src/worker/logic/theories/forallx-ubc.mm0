--| @syntax brackets ( ) [ ]
--| @syntax lint closed-sentences
--| @syntax lint parenthesize-binary-only
--| @syntax display drop-outer-parens
delimiter $ ( ) [ ] , ; { } $;

--| @syntax role sentence
provable sort wff;

--| @vars x y z
sort var;
--| @vars a b c d e f g h i j k l m n o p q r s t u v w a1 a2 a3 a4 a5 a6 a7 a8 a9 b1 b2 b3 b4 b5 b6 b7 b8 b9 c1 c2 c3 c4 c5 c6 c7 c8 c9 d1 d2 d3 d4 d5 d6 d7 d8 d9 e1 e2 e3 e4 e5 e6 e7 e8 e9 f1 f2 f3 f4 f5 f6 f7 f8 f9 g1 g2 g3 g4 g5 g6 g7 g8 g9 h1 h2 h3 h4 h5 h6 h7 h8 h9 i1 i2 i3 i4 i5 i6 i7 i8 i9 j1 j2 j3 j4 j5 j6 j7 j8 j9 k1 k2 k3 k4 k5 k6 k7 k8 k9 l1 l2 l3 l4 l5 l6 l7 l8 l9 m1 m2 m3 m4 m5 m6 m7 m8 m9 n1 n2 n3 n4 n5 n6 n7 n8 n9 o1 o2 o3 o4 o5 o6 o7 o8 o9 p1 p2 p3 p4 p5 p6 p7 p8 p9 q1 q2 q3 q4 q5 q6 q7 q8 q9 r1 r2 r3 r4 r5 r6 r7 r8 r9 s1 s2 s3 s4 s5 s6 s7 s8 s9 t1 t2 t3 t4 t5 t6 t7 t8 t9 u1 u2 u3 u4 u5 u6 u7 u8 u9 v1 v2 v3 v4 v5 v6 v7 v8 v9 w1 w2 w3 w4 w5 w6 w7 w8 w9
sort name;
--| @syntax role individual
sort tm;
--| @syntax role argument-list
sort seq;

term v2t (x: var): tm;
coercion v2t: var > tm;
term n2t (a: name): tm;
coercion n2t: name > tm;
term t2s (te: tm): seq;
coercion t2s: tm > seq;

--| @syntax elided
term snil: seq;
--| @syntax juxtaposed
term scomma (sq tq: seq): seq;
infixl scomma: $,$ prec 10;

term A (sq: seq): wff;
term B (sq: seq): wff;
term C (sq: seq): wff;
term D (sq: seq): wff;
term E (sq: seq): wff;
term F (sq: seq): wff;
term G (sq: seq): wff;
term H (sq: seq): wff;
term I (sq: seq): wff;
term J (sq: seq): wff;
term K (sq: seq): wff;
term L (sq: seq): wff;
term M (sq: seq): wff;
term N (sq: seq): wff;
term O (sq: seq): wff;
term P (sq: seq): wff;
term Q (sq: seq): wff;
term R (sq: seq): wff;
term S (sq: seq): wff;
term T (sq: seq): wff;
term U (sq: seq): wff;
term V (sq: seq): wff;
term W (sq: seq): wff;
term X (sq: seq): wff;
term Y (sq: seq): wff;
term Z (sq: seq): wff;

--| @syntax role negation
term not (ph: wff): wff;
prefix not: $-$ prec 40;
prefix not: $~$ prec 40;
prefix not: $¬$ prec 40;

--| @syntax role conjunction
--| @syntax forbid mix
term and (ph ps: wff): wff;
infixr and: $/\$ prec 30;
infixr and: $^$ prec 30;
infixr and: $∧$ prec 30;
infixr and: $&$ prec 30;

--| @syntax role disjunction
--| @syntax forbid mix
term or (ph ps: wff): wff;
infixr or: $\/$ prec 30;
infixr or: $|$ prec 30;
infixr or: $∨$ prec 30;

--| @syntax role conditional
--| @syntax forbid chain mix nest
term imp (ph ps: wff): wff;
infixr imp: $->$ prec 20;
infixr imp: $=>$ prec 20;
infixr imp: $>$ prec 20;
infixr imp: $→$ prec 20;
infixr imp: $⊃$ prec 20;

--| @syntax role biconditional
--| @syntax forbid chain mix nest
term iff (ph ps: wff): wff;
infixr iff: $<->$ prec 20;
infixr iff: $<=>$ prec 20;
infixr iff: $<>$ prec 20;
infixr iff: $↔$ prec 20;
infixr iff: $≡$ prec 20;

-- `Ax.` and `Ex.` for the ASCII typist, as in Magnus: `A` and `E` are
-- predicate letters, and only the dot tells `Ax.Axx` apart from one.
--| @syntax elab $ A ?x:var . $ => $ ∀ ?x $ input-only
--| @syntax elab $ E ?x:var . $ => $ ∃ ?x $ input-only
--| @syntax role forall
term all {x: var} (ph: wff x): wff;
prefix all: $@$ prec 40;
prefix all: $∀$ prec 40;

--| @syntax role exists
term ex {x: var} (ph: wff x): wff;
prefix ex: $3$ prec 40;
prefix ex: $∃$ prec 40;

--| @syntax elab $ ?a:tm ≠ ?b:tm $ => $ ¬ ?a = ?b $
--| @syntax role identity
term ideq (te ue: tm): wff;
infixl ideq: $=$ prec 50;
